{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["eslint", "react", "typescript", "oxc", "unicorn", "import", "jsx-a11y", "promise"],

  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },

  "rules": {
    "react/react-in-jsx-scope": "off",

    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/exhaustive-effect-dependencies": "off",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],

    "eslint/no-await-in-loop": "off",

    "oxc/no-map-spread": "off",

    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-useless-spread": "off",

    "promise/always-return": "off",

    "import/no-unassigned-import": "off",

    "jsx-a11y/autocomplete-valid": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": [
      "warn",
      {
        "ignoreNonDOM": true
      }
    ],
    "jsx-a11y/role-supports-aria-props": "warn",
    "jsx-a11y/label-has-associated-control": [
      "warn",
      {
        "depth": 3
      }
    ],
    "jsx-a11y/no-noninteractive-tabindex": [
      "warn",
      {
        "roles": ["tabpanel", "region"]
      }
    ]
  },

  "overrides": [
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**/*.ts", "src/test/**/*.tsx"],
      "plugins": ["eslint", "react", "typescript", "oxc", "unicorn", "import", "vitest"],
      "rules": {
        "react/jsx-no-constructed-context-values": "off",
        "react/no-object-type-as-default-prop": "off",

        "vitest/require-mock-type-parameters": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-standalone-expect": [
          "error",
          {
            "additionalTestBlockFunctions": ["afterEach"]
          }
        ],
        "vitest/valid-expect": "error",
        "vitest/expect-expect": "warn",
        "vitest/no-conditional-expect": "off",
        "vitest/prefer-importing-vitest-globals": "warn"
      }
    }
  ]
}
